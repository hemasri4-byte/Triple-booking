<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Serenity | Yoga & Wellness</title>

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
:root {
    --green: #526b55;
    --dark: #263d30;
    --cream: #f7f5ee;
    --sage: #e5ebdf;
    --text: #343d35;
    --gold: #c49a62;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: 'DM Sans', sans-serif;
    background: var(--cream);
    color: var(--text);
}

h1,h2,h3 {
    font-family: 'Playfair Display', serif;
}

nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 8%;
    background: var(--cream);
    position: sticky;
    top: 0;
    z-index: 100;
}

.logo {
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    color: var(--green);
    font-weight: bold;
}

.nav-links {
    display: flex;
    gap: 28px;
    list-style: none;
}

.nav-links a {
    text-decoration: none;
    color: var(--text);
    font-size: 14px;
}

.nav-links a:hover {
    color: var(--gold);
}

.menu-btn {
    display: none;
    border: none;
    background: none;
    font-size: 26px;
    cursor: pointer;
}

.btn {
    display: inline-block;
    padding: 13px 27px;
    border-radius: 30px;
    background: var(--green);
    color: white;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: .3s;
}

.btn:hover {
    background: var(--dark);
    transform: translateY(-2px);
}

.hero {
    min-height: 620px;
    display: flex;
    align-items: center;
    padding: 80px 8%;
    background:
    linear-gradient(90deg,rgba(20,35,25,.68),rgba(20,35,25,.12)),
    url('https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=1800') center/cover;
    color: white;
}

.hero-content {
    max-width: 620px;
}

.hero h1 {
    font-size: clamp(42px,6vw,75px);
    line-height: 1.1;
    margin-bottom: 25px;
}

.hero p {
    font-size: 17px;
    line-height: 1.8;
    margin-bottom: 30px;
}

.hero .btn {
    background: var(--gold);
}

section {
    padding: 85px 8%;
}

.section-title {
    text-align: center;
    margin-bottom: 45px;
}

.section-title h2 {
    font-size: 42px;
    color: var(--dark);
    margin-bottom: 12px;
}

.section-title p {
    color: #777;
}

.about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 55px;
}

.about img {
    width: 100%;
    height: 430px;
    object-fit: cover;
    border-radius: 12px;
}

.about h2 {
    font-size: 42px;
    color: var(--dark);
    margin-bottom: 20px;
}

.about p {
    line-height: 1.9;
    margin-bottom: 20px;
    color: #666;
}

.grid {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 25px;
}

.card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0,0,0,.05);
    transition: .3s;
}

.card:hover {
    transform: translateY(-7px);
}

.card img {
    width: 100%;
    height: 230px;
    object-fit: cover;
}

.card-content {
    padding: 23px;
}

.card h3 {
    font-size: 23px;
    margin-bottom: 12px;
    color: var(--dark);
}

.card p {
    color: #777;
    line-height: 1.7;
    font-size: 14px;
}

.sage-section {
    background: var(--sage);
}

.instructor img {
    height: 300px;
}

.instructor .card-content {
    text-align: center;
}

.instructor h3 {
    margin-bottom: 6px;
}

.schedule-table {
    width: 100%;
    border-collapse: collapse;
    background: white;
    border-radius: 12px;
    overflow: hidden;
}

.schedule-table th,
.schedule-table td {
    padding: 20px;
    text-align: left;
    border-bottom: 1px solid #eee;
}

.schedule-table th {
    background: var(--green);
    color: white;
}

.schedule-table tr:hover {
    background: #f3f6ef;
}

.price {
    font-size: 35px;
    color: var(--green);
    font-weight: bold;
    margin: 15px 0;
}

.plan {
    text-align: center;
    padding: 35px 25px;
}

.plan ul {
    list-style: none;
    margin: 25px 0;
    line-height: 2.5;
    color: #777;
}

.plan.featured {
    border: 2px solid var(--green);
}

.articles .card img {
    height: 210px;
}

.contact {
    background: var(--dark);
    color: white;
    text-align: center;
}

.contact h2 {
    font-size: 42px;
    margin-bottom: 15px;
}

.contact p {
    margin-bottom: 25px;
    color: #d5ddd5;
}

footer {
    background: #1d3025;
    color: white;
    padding: 30px 8%;
    text-align: center;
    font-size: 14px;
}

footer p {
    margin: 8px;
}

@media(max-width:900px) {
    .grid {
        grid-template-columns: repeat(2,1fr);
    }

    .about {
        grid-template-columns: 1fr;
    }
}

@media(max-width:650px) {
    nav {
        padding: 18px 5%;
    }

    .menu-btn {
        display: block;
    }

    .nav-links {
        display: none;
        position: absolute;
        top: 70px;
        left: 0;
        width: 100%;
        background: var(--cream);
        flex-direction: column;
        padding: 25px;
        gap: 20px;
    }

    .nav-links.active {
        display: flex;
    }

    .grid {
        grid-template-columns: 1fr;
    }

    section {
        padding: 60px 6%;
    }

    .hero {
        min-height: 550px;
        padding: 50px 6%;
    }

    .section-title h2,
    .about h2 {
        font-size: 34px;
    }

    .schedule-table th,
    .schedule-table td {
        padding: 12px 8px;
        font-size: 12px;
    }
}
</style>
</head>

<body>

<nav>
