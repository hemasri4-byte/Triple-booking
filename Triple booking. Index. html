<p class="modal-note">
  This is a demonstration booking interface.
  No real ticket is reserved and no payment is processed.
</p>

<button class="search-btn" onclick="closeModal()">Done</button>

  </div>
</div><script>

// SAMPLE BUS DATA

const busData = [
  {
