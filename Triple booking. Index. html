  }
];

// SAMPLE TRAIN DATA

const trainData = [
  {
    id: 4,
    name: "Kacheguda Express",
    type: "Train No. 17603",
    from: "Hyderabad",
    to: "Bangalore",
    departure: "16:45",
    arrival: "08:30",
    duration: "15h 45m",
    price: 650,
    rating: 4.3,
    seats: 45
  },
  {
    id: 5,
    name: "Yeshvantpur Express",
    type: "Train No. 16570",
    from: "Hyderabad",
    to: "Bangalore",
    departure: "21:10",
    arrival: "11:00",
    duration: "13h 50m",
    price: 780,
    rating: 4.6,
    seats: 28
  },
  {
    id: 6,
    name: "Kacheguda Yesvantpur Express",
    type: "Train No. 17603",
    from: "Hyderabad",
    to: "Bangalore",
    departure: "18:00",
    arrival: "09:15",
    duration: "15h 15m",
    price: 550,
    rating: 4.2,
    seats: 32
  }
];

let travelType = "bus";
let selectedTrip = null;

// SET MINIMUM JOURNEY DATE

const today = new Date();
const localToday = new Date(
  today.getTime() - today.getTimezoneOffset() * 60000
).toISOString().split("T")[0];

document.getElementById("date").min = localToday;
document.getElementById("date").value = localToday;

document.getElementById("year").textContent =
  new Date().getFullYear();

// MOBILE NAVIGATION

document.getElementById("menuBtn").addEventListener("click", () => {
  document.getElementById("navLinks").classList.toggle("show");
});

document.querySelectorAll(".nav-links a").forEach(link => {
  link.addEventListener("click", () => {
    document.getElementById("navLinks").classList.remove("show");
  });
});

// CHANGE BUS / TRAIN

function changeType(type) {

  travelType = type;

  document.getElementById("busTab").classList.toggle(
    "active", type === "bus"
  );

  document.getElementById("trainTab").classList.toggle(
    "active", type === "train"
  );

  document.getElementById("resultsSection").hidden = true;
}

// SWAP CITIES

function swapCities() {

  const from = document.getElementById("from");
  const to = document.getElementById("to");

  const temp = from.value;

  from.value = to.value;
  to.value = temp;
}

// SEARCH TRIPS

document.getElementById("bookingForm").addEventListener("submit", function(e) {

  e.preventDefault();

  const from = document.getElementById("from").value.trim();
  const to = document.getElementById("to").value.trim();
  const date = document.getElementById("date").value;
  const passengers = Number(document.getElementById("passengers").value);

  if (!from || !to || !date) {
    alert("Please fill in all booking details.");
    return;
  }

  if (from.toLowerCase() === to.toLowerCase()) {
    alert("Departure and destination cannot be the same.");
    return;
  }

  if (date < localToday) {
    alert("Please select a valid future journey date.");
    return;
  }

  const data = travelType === "bus" ? busData : trainData;

  const results = data.filter(trip =>
    trip.from.toLowerCase() === from.toLowerCase() &&
    trip.to.toLowerCase() === to.toLowerCase()
  );

  displayResults(results, from, to, date, passengers);

});

// DISPLAY RESULTS

function displayResults(results, from, to, date, passengers) {

  const section = document.getElementById("resultsSection");
  const list = document.getElementById("resultsList");

  section.hidden = false;

  document.getElementById("routeTitle").textContent =
    from + " → " + to;

  document.getElementById("routeDetails").textContent =
    date + " | " + passengers + " Passenger(s) | " +
    travelType.toUpperCase();

  document.getElementById("resultCount").textContent =
    results.length + " Options Found";

  list.innerHTML = "";

  if (results.length === 0) {

    list.innerHTML = `
      <div class="empty-results">
        <h3>No journeys found</h3>
        <p>No sample ${travelType} services are available for this route.</p>
        <p>Try Hyderabad to Bangalore to view sample journeys.</p>
      </div>
    `;

  } else {

    results.forEach(trip => {

      const card = document.createElement("div");
      card.className = "trip-card";

      card.innerHTML = `
        <div class="trip-main">

          <div class="operator">
            <div class="operator-icon">
              ${travelType === "bus" ? "🚌" : "🚆"}
            </div>

            <div>
              <h3>${trip.name}</h3>
              <p>${trip.type}</p>
            </div>
          </div>

          <div class="journey-time">

            <div>
              <strong>${trip.departure}</strong>
              <span>${trip.from}</span>
            </div>

            <div class="duration">
              <span>${trip.duration}</span>
              <div class="duration-line"></div>
            </div>

            <div>
              <strong>${trip.arrival}</strong>
              <span>${trip.to}</span>
            </div>

          </div>

          <div class="price">
            <span>Starting from</span>
            <strong>₹${trip.price}</strong>
            <small>${trip.seats} seats available</small>
          </div>

          <button class="book-btn">Select</button>

        </div>

        <div class="trip-footer">
          <span>⭐ ${trip.rating} Rating</span>
          <span>🛡️ Verified Operator</span>
          <span>❄️ AC</span>
          <span>✓ Comfortable Journey</span>
        </div>
      `;

      card.querySelector(".book-btn").addEventListener("click", () => {
        openModal(trip, date, passengers);
      });

      list.appendChild(card);

    });

  }

  section.scrollIntoView({ behavior: "smooth" });

}

// OPEN BOOKING MODAL

function openModal(trip, date, passengers) {

  selectedTrip = trip;

  const total = trip.price * passengers;

  document.getElementById("modalDetails").innerHTML = `

    <p><span>Operator</span><strong>${trip.name}</strong></p>

    <p><span>Journey</span><strong>${trip.from} → ${trip.to}</strong></p>

    <p><span>Travel Date</span><strong>${date}</strong></p>

    <p><span>Passengers</span><strong>${passengers}</strong></p>

    <p><span>Price per person</span><strong>₹${trip.price}</strong></p>

    <p><span>Total Amount</span><strong>₹${total}</strong></p>

  `;

  document.getElementById("modalBackdrop").classList.add("show");

}

// CLOSE MODAL

function closeModal() {

  document.getElementById("modalBackdrop").classList.remove("show");

  selectedTrip = null;

}

document.getElementById("modalBackdrop").addEventListener("click", function(e) {

  if (e.target === this) {
    closeModal();
  }

});

// DESTINATION BUTTONS

function setDestination(from, to) {

  document.getElementById("from").value = from;
  document.getElementById("to").value = to;

  document.getElementById("booking").scrollIntoView({
    behavior: "smooth"
  });

}

</script></body>
</html>
