<!DOCTYPE html><html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Triply - Book bus and train tickets with ease.">
<title>Triply | Travel Made Simple</title><style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
  --primary: #ed6b36;
  --dark: #172033;
  --muted: #718096;
  --light: #f8fafc;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: 'DM Sans', sans-serif;
  color: var(--dark);
  min-width: 320px;
}

button, input, select {
  font: inherit;
}

button {
  cursor: pointer;
}

a {
  text-decoration: none;
  color: inherit;
}

/* NAVBAR */

.navbar {
  height: 75px;
  background: white;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 15px #0000000b;
}

.nav-container {
  max-width: 1200px;
  width: 90%;
  height: 100%;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  font-family: 'Manrope', sans-serif;
  font-size: 28px;
  font-weight: 800;
  letter-spacing: -1px;
}

.logo span {
  color: var(--primary);
}

.nav-links {
  display: flex;
  gap: 32px;
  font-size: 14px;
  font-weight: 600;
}

.nav-links a:hover {
  color: var(--primary);
}

.nav-button {
  background: var(--primary);
  color: white;
  padding: 12px 20px;
  border-radius: 7px;
  font-weight: 700;
}

.menu-btn {
  display: none;
  border: 0;
  background: none;
  font-size: 25px;
}

/* HERO */

.hero {
  min-height: 580px;
  display: flex;
  align-items: center;
  color: white;
  background:
    linear-gradient(90deg, #101c31e8, #101c3160),
    url('https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1800&q=85')
    center/cover;
}

.hero-content {
  width: 90%;
  max-width: 1200px;
  margin: auto;
  padding: 75px 0;
}

.hero-tag {
  color: #ffad87;
  letter-spacing: 2px;
  font-size: 12px;
  font-weight: 800;
}

.hero h1 {
  font-family: 'Manrope', sans-serif;
  font-size: clamp(45px, 7vw, 76px);
  line-height: 1.15;
  margin: 25px 0;
}

.hero h1 span {
  color: #ff9b6a;
}

.hero p {
  max-width: 520px;
  line-height: 1.8;
  color: #e2e8f0;
}

.hero-buttons {
  display: flex;
  gap: 15px;
  margin-top: 30px;
  flex-wrap: wrap;
}

.primary-btn, .secondary-btn {
  padding: 14px 22px;
  border-radius: 7px;
  font-weight: 700;
  font-size: 14px;
}

.primary-btn {
  background: var(--primary);
  color: white;
}

.secondary-btn {
  border: 1px solid white;
  color: white;
}

.hero-stats {
  display: flex;
  gap: 55px;
  margin-top: 65px;
}

.hero-stats div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.hero-stats strong {
  font-size: 25px;
}

.hero-stats span {
  color: #cbd5e1;
  font-size: 12px;
}

/* COMMON SECTIONS */

.container {
  max-width: 1200px;
  width: 90%;
  margin: auto;
}

.section {
  padding: 80px 0;
}

.section-heading {
  text-align: center;
  margin-bottom: 35px;
}

.section-label {
  color: var(--primary);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
}

.section-heading h2 {
  font-family: 'Manrope', sans-serif;
  font-size: clamp(27px, 4vw, 37px);
  margin: 12px 0;
}

.section-heading p {
  color: var(--muted);
  font-size: 14px;
}

/* BOOKING */

.booking-section {
  background: var(--light);
}

.booking-card {
  background: white;
  padding: 25px;
  border-radius: 15px;
  box-shadow: 0 10px 40px #17203312;
}

.tabs {
  display: flex;
  gap: 25px;
  border-bottom: 1px solid #edf0f4;
  margin-bottom: 25px;
}

.tab {
  padding: 12px 15px;
  border: 0;
  border-bottom: 3px solid transparent;
  background: white;
  font-weight: 700;
  color: #718096;
}

.tab.active {
  color: var(--primary);
  border-color: var(--primary);
}

.booking-form {
  display: grid;
  grid-template-columns: 1fr 40px 1fr 1fr 1fr auto;
  align-items: center;
  gap: 12px;
}

.field {
  padding: 13px;
  border: 1px solid #e4e9ef;
  border-radius: 8px;
  min-width: 0;
}

.field label {
  display: block;
  color: #8490a0;
  font-size: 10px;
  font-weight: 800;
  margin-bottom: 10px;
}

.field input, .field select {
  width: 100%;
  border: none;
  outline: none;
  background: transparent;
  font-size: 14px;
  font-weight: 700;
  color: var(--dark);
}

.swap-btn {
  border: 1px solid #f5d5c6;
  background: #fff5ef;
  color: var(--primary);
  height: 36px;
  width: 36px;
  border-radius: 50%;
  font-size: 19px;
}

.search-btn, .book-btn {
  background: var(--primary);
  color: white;
  border: 0;
  border-radius: 8px;
  padding: 15px 22px;
  font-weight: 700;
}

.search-btn:hover, .book-btn:hover, .primary-btn:hover {
  background: #d95424;
}

/* RESULTS */

.results-section {
  padding: 70px 0;
}

.results-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 30px;
}

.results-heading h2 {
  font-size: 30px;
  margin: 10px 0;
}

.results-heading p {
  color: var(--muted);
  font-size: 13px;
}

.result-count {
  background: #fff0e9;
  color: var(--primary);
  padding: 10px 15px;
  border-radius: 25px;
  font-size: 12px;
  font-weight: 700;
}

.results-list {
  display: grid;
  gap: 18px;
}

.trip-card {
  padding: 23px;
  border: 1px solid #e7ecf1;
  border-radius: 12px;
  transition: .2s;
}

.trip-card:hover {
  border-color: #ed9c78;
  box-shadow: 0 8px 25px #0000000b;
}

.trip-main {
  display: grid;
  grid-template-columns: 1.2fr 1.6fr .7fr auto;
  align-items: center;
  gap: 20px;
}

.operator {
  display: flex;
  align-items: center;
  gap: 12px;
}

.operator-icon {
  width: 45px;
  height: 45px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: #fff0e9;
  color: var(--primary);
  font-size: 22px;
}

.operator h3 {
  font-size: 15px;
}

.operator p {
  color: var(--muted);
  font-size: 12px;
  margin-top: 5px;
}

.journey-time {
  display: flex;
  justify-content: space-between;
  align-items: center;
  text-align: center;
  gap: 10px;
}

.journey-time div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.journey-time strong {
  font-size: 19px;
}

.journey-time span {
  font-size: 11px;
  color: var(--muted);
}

.duration {
  flex: 1;
}

.duration-line {
  border-top: 1px dashed #b7c1ce;
  margin-top: 8px;
}

.price {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.price span {
  font-size: 11px;
  color: var(--muted);
}

.price strong {
  font-size: 23px;
}

.price small {
  color: #249765;
}

.trip-footer {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  border-top: 1px solid #edf0f4;
  margin-top: 20px;
  padding-top: 15px;
  color: #718096;
  font-size: 11px;
}

.empty-results {
  text-align: center;
  padding: 50px 15px;
  color: var(--muted);
}

.empty-results h3 {
  margin: 15px 0;
  color: var(--dark);
}

/* FEATURES */

.features-section {
  background: var(--light);
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.feature-card {
  background: white;
  padding: 28px 22px;
  border-radius: 12px;
  border: 1px solid #edf0f4;
}

.feature-icon {
  width: 48px;
  height: 48px;
  background: #fff0e9;
  color: var(--primary);
  display: grid;
  place-items: center;
  border-radius: 10px;
  font-size: 22px;
  margin-bottom: 18px;
}

.feature-card h3 {
  margin-bottom: 12px;
  font-size: 16px;
}

.feature-card p {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.7;
}

/* DESTINATIONS */

.destination-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.destination-card {
  min-height: 330px;
  border-radius: 12px;
  overflow: hidden;
  position: relative;
  display: flex;
  align-items: flex-end;
  padding: 25px;
  color: white;
  background-size: cover;
  background-position: center;
}

.destination-card::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(0deg, #101c31e8, transparent);
}

.destination-one {
  background-image: url('https://images.unsplash.com/photo-1570168007204-dfb528c6958f?auto=format&fit=crop&w=800&q=80');
}

.destination-two {
  background-image: url('https://images.unsplash.com/photo-1596176530529-78163a4f7af2?auto=format&fit=crop&w=800&q=80');
}

.destination-three {
  background-image: url('https://images.unsplash.com/photo-1582510003544-4d00b7f74220?auto=format&fit=crop&w=800&q=80');
}

.destination-info {
  position: relative;
  z-index: 1;
}

.destination-info small {
  color: #ffad87;
  letter-spacing: 2px;
  font-weight: 800;
}

.destination-info h3 {
  font-size: 28px;
  margin: 10px 0;
}

.destination-info p {
  font-size: 13px;
  color: #e2e8f0;
}

.destination-info button {
  border: 0;
  background: white;
  color: var(--dark);
  border-radius: 6px;
  padding: 10px 15px;
  font-weight: 700;
  margin-top: 16px;
}

/* FOOTER */

.footer {
  background: #121c2d;
  color: white;
  padding: 50px 0 0;
}

.footer-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  padding-bottom: 35px;
}

.footer-logo {
  font-size: 28px;
  font-weight: 800;
}

.footer-logo span {
  color: #ff9868;
}

.footer-content p {
  color: #aab5c5;
  font-size: 13px;
  margin-top: 12px;
}

.footer-links {
  display: flex;
  gap: 22px;
  flex-wrap: wrap;
  font-size: 13px;
  color: #c1cad6;
}

.footer-links a:hover {
  color: #ff9868;
}

.copyright {
  text-align: center;
  border-top: 1px solid #2a3547;
  padding: 20px;
  color: #aab5c5;
  font-size: 12px;
}

/* BOOKING MODAL */

.modal-backdrop {
  display: none;
  position: fixed;
  inset: 0;
  background: #101c31b8;
  z-index: 200;
  justify-content: center;
  align-items: center;
  padding: 20px;
}

.modal-backdrop.show {
  display: flex;
}

.modal {
  background: white;
  padding: 30px;
  border-radius: 15px;
  width: 100%;
  max-width: 450px;
  position: relative;
}

.modal h2 {
  margin: 15px 0;
}

.modal-close {
  position: absolute;
  right: 15px;
  top: 15px;
  border: 0;
  background: transparent;
  font-size: 22px;
}

.modal-details {
  background: var(--light);
  padding: 17px;
  border-radius: 10px;
}

.modal-details p {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  margin: 12px 0;
  font-size: 13px;
}

.modal-details strong {
  color: var(--dark);
}

.modal-note {
  color: var(--muted);
  font-size: 11px;
  line-height: 1.6;
  margin: 15px 0;
}

.modal .search-btn {
  width: 100%;
}

/* RESPONSIVE */

@media(max-width: 1050px) {
  .booking-form {
    grid-template-columns: 1fr 35px 1fr;
  }

  .search-btn {
    grid-column: 1 / -1;
  }

  .features-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .trip-main {
    grid-template-columns: 1fr 1.5fr .7fr;
  }

  .book-btn {
    grid-column: 3;
  }
}

@media(max-width: 768px) {
  .nav-links {
    display: none;
    position: absolute;
    top: 75px;
    left: 0;
    right: 0;
    background: white;
    flex-direction: column;
    padding: 25px;
    box-shadow: 0 8px 15px #00000010;
  }

  .nav-links.show {
    display: flex;
  }

  .menu-btn {
    display: block;
  }

  .nav-button {
    display: none;
  }

  .hero {
    min-height: 540px;
  }

  .hero-stats {
    gap: 25px;
  }

  .booking-form {
    grid-template-columns: 1fr;
  }

  .swap-btn {
    margin: auto;
    transform: rotate(90deg);
  }

  .search-btn {
    grid-column: auto;
  }

  .trip-main {
    grid-template-columns: 1fr 1fr;
  }

  .operator {
    grid-column: 1 / -1;
  }

  .journey-time {
    grid-column: 1 / -1;
  }

  .book-btn {
    grid-column: 2;
    justify-self: end;
  }

  .destination-grid {
    grid-template-columns: 1fr;
  }

  .destination-card {
    min-height: 290px;
  }

  .footer-content {
    flex-direction: column;
    align-items: flex-start;
  }
}

@media(max-width: 480px) {
  .hero h1 {
    font-size: 46px;
  }

  .hero-buttons {
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-stats {
    gap: 18px;
  }

  .hero-stats strong {
    font-size: 21px;
  }

  .features-grid {
    grid-template-columns: 1fr;
  }

  .results-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .trip-card {
    padding: 16px;
  }

  .trip-footer {
    gap: 10px;
  }
}
